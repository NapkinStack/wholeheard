# Ties every change to an owner (.nstack/handbook/07-governance.md §7).
# Updated automatically by nstack new-module.

# Default owner: every path the rules below do not name. With the code owner review
# required, a human approval covers every file (.nstack/handbook/07-governance.md §7).
*                              @NapkinStack/maintainers

# Foundation: any change to the OS itself goes through an ADR.
/AGENTS.md                     @NapkinStack/maintainers
/.nstack/                      @NapkinStack/maintainers
/.github/                      @NapkinStack/maintainers
/.copier-answers.yml           @NapkinStack/maintainers

# Modules — one line per module, added by the scaffolding.
/modules/capture/              @NapkinStack/maintainers
/modules/transcription/        @NapkinStack/maintainers
/modules/summary/              @NapkinStack/maintainers
/modules/export/               @NapkinStack/maintainers

# Contracts: the most critical boundary in the system, never orphaned.
/contracts/                    @NapkinStack/maintainers
/modules/shell/                @NapkinStack/maintainers
/modules/platform/             @NapkinStack/maintainers
/modules/install/              @NapkinStack/maintainers
