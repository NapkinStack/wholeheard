{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "session.json of a session recorded as session-audio/v2",
  "description": "What a schema cannot say is on the contract's page: that `started` is the instant 0 of the session's clock, that an absent `stopped` means still recording or ended by a crash, and that a track named here has its file.",
  "type": "object",
  "properties": {
    "contract": {
      "const": "session-audio/v2"
    },
    "started": {
      "$ref": "#/$defs/instant"
    },
    "stopped": {
      "$ref": "#/$defs/instant"
    },
    "tracks": {
      "type": "object",
      "properties": {
        "local": {
          "$ref": "#/$defs/device"
        },
        "remote": {
          "$ref": "#/$defs/device"
        }
      },
      "anyOf": [
        {
          "required": [
            "local"
          ]
        },
        {
          "required": [
            "remote"
          ]
        }
      ]
    }
  },
  "required": [
    "contract",
    "started",
    "tracks"
  ],
  "$defs": {
    "instant": {
      "description": "ISO 8601 with the local offset, as the page says: the page's promise, not this schema's — no reader reads its shape today.",
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "[\\n\\r]"
      }
    },
    "device": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string"
        }
      },
      "required": [
        "device"
      ]
    }
  }
}
