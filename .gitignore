__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
build/
target/
coverage/
.env
.env.*
!.env.example
.DS_Store

# Skills generated from playbooks/ — the source of truth is playbooks/
.claude/skills/

# Evidence of the end-to-end scenarios: a CI artefact, never committed
.evidence/

# Editors and IDEs
.idea/
*.iml
*.swp
*.swo
*~

# Local agent settings: machine-specific paths and permissions
.claude/settings.local.json

# Agent session and machine state: written by the tool as it runs, never by the project.
# `.claude/settings.json` and `.claude/hooks/` are deliberately absent from this list —
# project-level settings and hooks are shared with the team on purpose. What follows is
# per-machine or per-run, and would carry one workstation's paths into a tracked file,
# which hygiene H1 refuses.
.claude/.cc-writes/
.claude/launch.json
.claude/loop.md
.claude/scheduled_tasks.json
.claude/output-styles/
.claude/routines/
.claude/workflows/

# MCP server configuration: names local commands and absolute paths (hygiene H1)
.mcp.json

# System noise
Thumbs.db
Desktop.ini

# Sensitive material — see SECURITY.md S1
# This REDUCES accidents, it PROTECTS nothing: the real barriers are gitleaks
# (hook and CI) and push protection (CONTRIBUTING.md).
*.pem
*.key
id_rsa*
id_ed25519*
.envrc
secrets.*
